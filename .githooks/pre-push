#!/usr/bin/env bash
# Dispatches a frontend-push event to clockwise-like after every push to main.
#
# One-time setup:
#   git config core.hooksPath .githooks
#
# Token setup (GitHub PAT with repo Actions write scope on clockwise-like):
#   mkdir -p ~/.config/paceday
#   echo "ghp_your_token_here" > ~/.config/paceday/backend_repo_token
#   chmod 600 ~/.config/paceday/backend_repo_token

set -euo pipefail

TOKEN_FILE="$HOME/.config/paceday/backend_repo_token"

while read -r local_ref local_sha remote_ref _remote_sha; do
    [[ "$remote_ref" != "refs/heads/main" ]] && continue
    if [[ ! -f "$TOKEN_FILE" ]]; then
        echo "pre-push: no token at $TOKEN_FILE — skipping clockwise-like dispatch" >&2
        exit 0
    fi
    TOKEN=$(cat "$TOKEN_FILE")
    echo "pre-push: dispatching frontend-push to clockwise-like (sha: ${local_sha:0:7})…" >&2
    HTTP=$(curl -s -o /dev/null -w "%{http_code}" \
        -X POST \
        -H "Authorization: Bearer $TOKEN" \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        https://api.github.com/repos/Enach/clockwise-like/dispatches \
        -d "{\"event_type\":\"frontend-push\",\"client_payload\":{\"sha\":\"$local_sha\"}}")
    if [[ "$HTTP" == "204" ]]; then
        echo "pre-push: dispatch accepted (204)" >&2
    else
        echo "pre-push: dispatch returned HTTP $HTTP — check token/permissions" >&2
    fi
done

exit 0
