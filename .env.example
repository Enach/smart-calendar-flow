# Backend API base URL — used by src/lib/api.ts.
# Defaults to http://localhost:3001 when unset.
VITE_API_URL=http://localhost:3001

# Sentry frontend DSN (PAC-14, PAC-86). Build-time: Vite inlines it when the
# image is built, so changing it means rebuilding. There is NO default: empty or
# unset means web error monitoring is off and nothing is sent anywhere.
# To turn it on, set it to your Sentry project's DSN at build time AND set the
# api repo's NGINX_CSP_SENTRY_ORIGIN to that DSN's origin (scheme://host),
# or the browser's CSP blocks the events. See docs/runbook.md.
VITE_SENTRY_DSN=
